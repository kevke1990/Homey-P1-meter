{
  "id": "com.generic.p1meter",
  "version": "1.4.5",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Generic P1 Meter",
    "nl": "Generieke P1 Meter"
  },
  "description": {
    "en": "Professional P1 energy dashboard for Chargee Sparky",
    "nl": "Professioneel P1 energiedashboard voor Chargee Sparky"
  },
  "category": "energy",
  "permissions": [],
  "widgets": {
    "energy_dashboard": {
      "name": {
        "en": "Energy Dashboard",
        "nl": "Energie Dashboard"
      },
      "height": 820,
      "transparent": false,
      "devices": {
        "type": "app",
        "singular": true
      },
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "energy_dashboard",
      "settings": [
        {
          "id": "electricity_price",
          "type": "number",
          "title": {
            "en": "Electricity price (€/kWh)",
            "nl": "Stroomprijs (€/kWh)"
          },
          "value": 0.3,
          "min": 0,
          "max": 2,
          "step": 0.01
        },
        {
          "id": "feedin_price",
          "type": "number",
          "title": {
            "en": "Feed-in price (€/kWh)",
            "nl": "Terugleververgoeding (€/kWh)"
          },
          "value": 0.15,
          "min": 0,
          "max": 2,
          "step": 0.01
        },
        {
          "id": "gas_price",
          "type": "number",
          "title": {
            "en": "Gas price (€/m³)",
            "nl": "Gasprijs (€/m³)"
          },
          "value": 1.0,
          "min": 0,
          "max": 5,
          "step": 0.01
        }
      ]
    }
  },
  "author": {
    "name": "Chargee Sparky"
  },
  "runtime": "nodejs",
  "drivers": [
    {
      "id": "p1_dongle",
      "name": {
        "en": "Chargee Sparky P1 Meter",
        "nl": "Chargee Sparky P1 Meter"
      },
      "class": "sensor",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "measure_power",
        "measure_power.returned",
        "meter_power",
        "meter_power.returned",
        "meter_gas",
        "p1_grid_import_power",
        "p1_grid_export_power"
      ],
      "settings": [
        {
          "type": "text",
          "id": "ip",
          "value": "192.168.8.224",
          "label": {
            "en": "IP Address",
            "nl": "IP-adres"
          }
        },
        {
          "type": "number",
          "id": "port",
          "value": 3602,
          "label": {
            "en": "TCP Port",
            "nl": "TCP-poort"
          }
        }
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "images": {
        "small": "/drivers/p1_dongle/assets/images/small.png",
        "large": "/drivers/p1_dongle/assets/images/large.png",
        "xlarge": "/drivers/p1_dongle/assets/images/xlarge.png"
      },
      "energy": {
        "cumulative": true,
        "cumulativeImportedCapability": "meter_power",
        "cumulativeExportedCapability": "meter_power.returned"
      },
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Grid import power",
            "nl": "Netafname vermogen"
          }
        },
        "measure_power.returned": {
          "title": {
            "en": "Grid export power",
            "nl": "Teruglevering vermogen"
          }
        },
        "meter_power": {
          "title": {
            "en": "Imported energy",
            "nl": "Afgenomen energie"
          }
        },
        "meter_power.returned": {
          "title": {
            "en": "Exported energy",
            "nl": "Teruggeleverde energie"
          }
        },
        "meter_gas": {
          "title": {
            "en": "Gas meter",
            "nl": "Gasmeter"
          }
        },
        "p1_grid_import_power": {
          "title": {
            "en": "Current consumption",
            "nl": "Huidig verbruik"
          },
          "preventInsights": false
        },
        "p1_grid_export_power": {
          "title": {
            "en": "Current feed-in",
            "nl": "Huidige teruglevering"
          },
          "preventInsights": false
        }
      }
    }
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#62A8FF",
  "capabilities": {
    "p1_grid_import_power": {
      "type": "number",
      "title": {
        "en": "Grid import power",
        "nl": "Huidig verbruik"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "W",
        "nl": "W"
      },
      "min": 0,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor"
    },
    "p1_grid_export_power": {
      "type": "number",
      "title": {
        "en": "Grid export power",
        "nl": "Huidige teruglevering"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "W",
        "nl": "W"
      },
      "min": 0,
      "step": 1,
      "decimals": 0,
      "uiComponent": "sensor"
    }
  }
}
