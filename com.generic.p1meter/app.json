{
  "id": "com.generic.p1meter",
  "version": "1.1.1",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "name": {
    "en": "Generic P1 Meter",
    "nl": "Generieke P1 Meter"
  },
  "description": {
    "en": "Connects generic Wi-Fi P1 Dongles to Homey",
    "nl": "Verbindt generieke Wi-Fi P1 Dongles met Homey"
  },
  "category": "energy",
  "permissions": [],
  "author": {
    "name": "Jules"
  },
  "platforms": [
    "local"
  ],
  "brandColor": "#147CFF",
  "drivers": [
    {
      "name": {
        "en": "Chargee Sparky P1 Meter",
        "nl": "Chargee Sparky P1 Meter"
      },
      "class": "sensor",
      "connectivity": [
        "lan"
      ],
      "capabilities": [
        "measure_power",
        "measure_power.returned",
        "meter_power",
        "meter_power.returned",
        "meter_gas"
      ],
      "settings": [
        {
          "type": "text",
          "id": "ip",
          "value": "192.168.8.224",
          "label": {
            "en": "IP Address",
            "nl": "IP Adres"
          }
        },
        {
          "type": "number",
          "id": "port",
          "value": 3602,
          "label": {
            "en": "TCP Port",
            "nl": "TCP Poort"
          }
        }
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "p1_dongle"
    }
  ],
  "widgets": [
    {
      "name": {
        "en": "Energy Dashboard",
        "nl": "Energie Dashboard"
      },
      "height": 820,
      "transparent": false,
      "devices": {
        "type": "global",
        "singular": true,
        "filter": {
          "driver_id": "p1_dongle"
        }
      },
      "settings": [
        {
          "id": "electricity_price",
          "type": "number",
          "title": {
            "en": "Electricity price (€/kWh)",
            "nl": "Stroomprijs (€/kWh)"
          },
          "value": 0.3,
          "min": 0,
          "max": 2,
          "step": 0.01
        },
        {
          "id": "feedin_price",
          "type": "number",
          "title": {
            "en": "Feed-in price (€/kWh)",
            "nl": "Terugleververgoeding (€/kWh)"
          },
          "value": 0.15,
          "min": 0,
          "max": 2,
          "step": 0.01
        },
        {
          "id": "gas_price",
          "type": "number",
          "title": {
            "en": "Gas price (€/m³)",
            "nl": "Gasprijs (€/m³)"
          },
          "value": 1.0,
          "min": 0,
          "max": 5,
          "step": 0.01
        }
      ],
      "api": {
        "getData": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "energy_dashboard"
    }
  ]
}
